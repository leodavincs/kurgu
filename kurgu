#!/bin/bash
# Kurgu launcher: kurgu [project_dir] [server options]   (works through symlinks)
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  [[ "$src" != /* ]] && src="$dir/$src"
done
dir="$(cd -P "$(dirname "$src")" && pwd)"
# A Python >= 3.10 (prefer a versioned one when several are installed)
pick_python() {
  # first choice: an interpreter that already has Kurgu's dependencies (the venv of this checkout); then any Python >= 3.10
  for need in 'import numpy, PIL, fontTools' 'pass'; do
    for c in python3.13 python3.12 python3.11 python3.10 python3 python; do
      p="$(command -v "$c" 2>/dev/null)" || continue
      "$p" -c "import sys; $need; sys.exit(0 if sys.version_info >= (3, 10) else 1)" 2>/dev/null && { echo "$p"; return 0; }
    done
  done
  # not on PATH: a Python that uv manages (`uv python find`), or the one in the installed tool environment
  if command -v uv >/dev/null 2>&1; then
    p="$(uv python find '>=3.10' 2>/dev/null)" && [ -x "$p" ] && { echo "$p"; return 0; }
  fi
  return 1
}
py="$(pick_python)" || { echo "Kurgu needs Python 3.10 or newer (found none on PATH). Easiest fix: run the installer (https://github.com/leodavincs/kurgu#install), it brings its own Python." >&2; exit 1; }
# `kurgu doctor [dir] [--json] [--fix]` and `kurgu setup-ffmpeg` (download a static ffmpeg for Kurgu)
if [ "$1" = "doctor" ]; then shift; exec "$py" "$dir/doctor.py" "$@"; fi
if [ "$1" = "setup-ffmpeg" ]; then shift; exec "$py" "$dir/ffmpeg_fetch.py" "$@"; fi
if [ "$1" = "wake" ]; then shift; exec "$py" "$dir/kurgu_cli.py" wake "$@"; fi                        # start the agent for sent notes (the on_send hook)
if [ "$1" = "setup-agent" ]; then shift; exec "$py" "$dir/kurgu_cli.py" setup-agent "$@"; fi          # register Kurgu with Codex / Claude Code
# `kurgu notes list|wait|done <dir>` goes straight to agent_notes.py (no editor modules imported). A folder called "notes" is opened as `kurgu ./notes`.
if [ "$1" = "notes" ]; then shift; exec "$py" "$dir/agent_notes.py" "$@"; fi
project="${1:-.}"; [ $# -gt 0 ] && shift
project0="$project"
project="$(cd "$project" 2>/dev/null && pwd)" || { echo "No such folder: $project0" >&2; exit 1; }
exec "$py" "$dir/server.py" "$project" "$@"
